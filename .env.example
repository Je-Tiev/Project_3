# ===================================================================
# PAPERLESS MEETING SYSTEM (.env.example)
# Sao chép tệp này thành .env trước khi khởi chạy hệ thống:
# cp .env.example .env
# ===================================================================

# --- CƠ SỞ DỮ LIỆU POSTGRESQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=paperless_meeting
POSTGRES_PORT=5432

# --- CẤU HÌNH BACKEND ASP.NET CORE ---
# Chuỗi kết nối CSDL:
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=paperless_meeting;Username=postgres;Password=your_secure_password_here;SSL Mode=Prefer

# Khóa bí mật ký JWT Token (BẮT BUỘC tối thiểu 256 bits / 32 ký tự ngẫu nhiên trong môi trường Production):
Jwt__Key=CHANGE_ME_IN_PRODUCTION_A_VERY_LONG_SECRET_KEY_AT_LEAST_32_BYTES
Jwt__Issuer=PaperlessMeetingBackend
Jwt__Audience=PaperlessMeetingFrontend

# Cấu hình lưu trữ tệp tin:
Storage__UploadPath=/app/Uploads

# --- CẤU HÌNH FRONTEND VITE ---
VITE_API_URL=/api
